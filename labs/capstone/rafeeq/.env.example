# Copy to labs/.env (the only .env path that .gitignore covers) and fill in. Never commit .env.

# Required: an OpenRouter key (https://openrouter.ai/keys). Free models only; 50 requests a day on the free tier.
# Repeated identical requests are served from labs/cache.
OPENROUTER_API_KEY=

# The models this project was evaluated with (free models change often; re-check availability before running).
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AGENT_SMALL_MODEL=nvidia/nemotron-3.5-lightning:free
AGENT_FALLBACKS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
